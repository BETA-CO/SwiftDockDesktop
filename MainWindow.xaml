                                                                                   <Border.Triggers>
                                                                                       <EventTrigger RoutedEvent="Loaded">
                                                                                           <BeginStoryboard>
                                                                                               <Storyboard RepeatBehavior="Forever">
                                                                                                   <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.25" Duration="0:0:0.7" AutoReverse="True"/>
                                                                                               </Storyboard>
                                                                                           </BeginStoryboard>
                                                                                       </EventTrigger>
                                                                                   </Border.Triggers>
                                                                               </Border>
                                                                               <TextBlock Text="Recording keys..." FontSize="12" FontWeight="Medium" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                                                           </StackPanel>

                                                                           <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                                               <Button x:Name="BtnSaveHotkey" Content="Save Combination" Style="{StaticResource SecondaryButton}" Click="BtnSaveHotkey_Click" Margin="0,0,8,0" Padding="16,0" Height="38"/>
                                                                               <Button x:Name="BtnClearHotkey" Content="Clear" Style="{StaticResource SecondaryButton}" Click="BtnClearHotkey_Click" Padding="14,0" Height="38"/>
                                                                           </StackPanel>
                                                                       </Grid>
                                                                  </StackPanel>
                                                              </Border>

                                                             <!-- Container for Preset Hotkeys Sections -->
                                                             <StackPanel x:Name="PanelHotkeyActionsContainer" Orientation="Vertical"/>
                                                         </StackPanel>
                                                     </ScrollViewer>
                                               </Grid>

