<Window x:Class="SwiftDock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SwiftDock"
        Title="SwiftDock" Height="720" Width="1280" MinWidth="1200" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="False"
        Foreground="#FFFFFF"
        WindowState="Maximized"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="LOGO.ico">

    <Window.Background>
        <SolidColorBrush Color="#16161A"/> 
    </Window.Background>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" 
                      ResizeBorderThickness="8" 
                      CornerRadius="12" 
                      GlassFrameThickness="0" 
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <local:LockedProfileIconConverter x:Key="LockedProfileIconConverter"/>
        <local:IconElementConverter x:Key="IconElementConverter"/>
        <local:ProfileMiniKeycapConverter x:Key="ProfileMiniKeycapConverter"/>

        <!-- Dark ContextMenu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HasDropShadow" Value="False"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="#111116"
                                BorderBrush="#2A2A3D"
                                BorderThickness="1.5"
                                CornerRadius="8"
                                Margin="8"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" 
                                                  ShadowDepth="2" 
                                                  Opacity="0.4" 
                                                  Color="Black"/>
                            </Border.Effect>
                            <ItemsPresenter KeyboardNavigation.TabNavigation="Cycle" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Separator Style for ContextMenu and Menus -->
        <Style TargetType="Separator" x:Key="{x:Static MenuItem.SeparatorStyleKey}">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#2A2A3D" HorizontalAlignment="Stretch" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Margin" Value="8,4"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#2A2A3D" HorizontalAlignment="Stretch" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark MenuItem Style -->
        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True" Margin="{TemplateBinding Margin}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                </Grid.ColumnDefinitions>

                                <ContentPresenter x:Name="Icon" ContentSource="Icon" Margin="8,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <ContentPresenter Grid.Column="1" x:Name="HeaderHost" ContentSource="Header" RecognizesAccessKey="True" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=MenuItem}}"/>
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>

                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="12,0,8,0" VerticalAlignment="Center" Foreground="#8E8E93"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Command chips preset buttons style -->
        <Style x:Key="PresetButton" TargetType="Button">
            <Setter Property="Background" Value="#111116"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="BorderBrush" Value="#1C1C24"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="3,3,6,6"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#252535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Pill Button Style (Done Rearranging) -->
        <Style x:Key="SuccessPillButton" TargetType="Button">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#059669"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="16" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#34D399"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#059669"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Pill Button Style (Delete Selected) -->
        <Style x:Key="DangerPillButton" TargetType="Button">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="16" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#F87171"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#DC2626"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Base text -->
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Inter"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
        </Style>



        <!-- Futuristic Panel Animation -->
        <Style x:Key="FuturisticPanel" TargetType="Grid">
            <Setter Property="Opacity" Value="0"/>
            <Style.Triggers>
                <Trigger Property="Visibility" Value="Visible">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CircleEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.4">
                                    <DoubleAnimation.EasingFunction>
                                        <CircleEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Custom Scrollbar -->
        <Style x:Key="ScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Setter Property="IsTabStop" Value="false"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="rectangle" 
                                CornerRadius="4" 
                                Background="#3E3E4C" 
                                Margin="1,1,1,1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="rectangle" Property="Background" Value="#6B6B7F"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="true">
                                <Setter TargetName="rectangle" Property="Background" Value="#A1A1AA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fully Hidden Scrollbar (Preserves mouse wheel & touchpad scrolling) -->
        <Style x:Key="HiddenScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="0"/>
            <Setter Property="Height" Value="0"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" Visibility="Collapsed"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar" BasedOn="{StaticResource HiddenScrollBarStyle}"/>

        <!-- Smooth Pixel-Based ScrollViewer Style -->
        <Style TargetType="ScrollViewer">
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.CacheLength" Value="200,200"/>
        </Style>

        <!-- Smooth Pixel-Based ListBox Style -->
        <Style TargetType="ListBox">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>
            <Setter Property="VirtualizingPanel.CacheLengthUnit" Value="Item"/>
            <Setter Property="VirtualizingPanel.CacheLength" Value="20,20"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
        </Style>

        <!-- Clean rounded TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111116"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#4B4B6E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Background" Value="#16161F"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean borderless TextBox without dark focus bar -->
        <Style x:Key="CleanBorderlessTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#8B5CF6"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean rounded PasswordBox -->
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#111116"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="CaretBrush" Value="#FFFFFF"/>
            <Setter Property="SelectionBrush" Value="#4B4B6E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="Background" Value="#16161F"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="BorderBrush" Value="#4B4B6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ListBoxItem -->
        <Style TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" CornerRadius="8" Padding="12,10" Background="Transparent" SnapsToDevicePixels="true">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#121216"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#1C1C24"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="border" Property="BorderThickness" Value="2,0,0,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBoxItem -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="2,1">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#2D2D44"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#6366F1"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ComboBox -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111116"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton"
                                         BorderBrush="{TemplateBinding BorderBrush}"
                                         BorderThickness="{TemplateBinding BorderThickness}"
                                         Background="{TemplateBinding Background}"
                                         Focusable="false"
                                         IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid HorizontalAlignment="Right" Width="30">
                                                <Path Fill="#9CA3AF" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M 0 0 L 4 4 L 8 0 Z"/>
                                            </Grid>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#161625" BorderBrush="#2A2A3D" BorderThickness="1" CornerRadius="8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="15" Color="#000000" Opacity="0.5" ShadowDepth="3"/>
                                        </Border.Effect>
                                    </Border>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="BorderBrush" Value="#4B4B6E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- RadioButton -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Height="16" Width="16" Margin="0,0,8,0">
                                <Ellipse x:Name="OuterRing" Stroke="#4B4B5E" StrokeThickness="2" Fill="#111116"/>
                                <Ellipse x:Name="Dot" Fill="#FFFFFF" Margin="4.5" Visibility="Collapsed"/>
                            </Grid>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#FFFFFF"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="OuterRing" Property="Stroke" Value="#8E8E93"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#D1D5DB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#1A1A22"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
 
        <!-- Secondary Button -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#2A2A35"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16161F"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#8E8E93"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22222A"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#12121A"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1F1F26"/>
                                <Setter Property="Foreground" Value="#4B5563"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Success Button -->
        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#10B981"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#059669"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#047857"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#B91C1C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ghost Button -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1A1A2A"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titlebar buttons -->
        <Style x:Key="TitlebarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#272730"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#1F1F28"/>
                    <Setter Property="Foreground" Value="#D1D5DB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TitlebarCloseButton" TargetType="Button" BasedOn="{StaticResource TitlebarButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#991B1B"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Category Tab Button Style -->
        <Style x:Key="CategoryTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="14,6.5"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252532"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Menu Item Style (Text buttons with hover) -->
        <Style x:Key="SidebarMenuItemStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10,16,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C1C24"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Profile ListBoxItem Style -->
        <Style x:Key="ProfileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,2,0,2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#16161F"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1C1C26"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryTabIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="Margin" Value="0"/>
        </Style>

        <Style x:Key="CategoryTabLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>

        <!-- Modern Toggle Switch Style for CheckBoxes -->
        <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#E4E4E7"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Label Text -->
                            <ContentPresenter Grid.Column="0" 
                                              Content="{TemplateBinding Content}" 
                                              ContentTemplate="{TemplateBinding ContentTemplate}" 
                                              VerticalAlignment="Center" 
                                              HorizontalAlignment="Left"
                                              Margin="0,0,8,0"/>

                            <!-- Toggle Track -->
                            <Border Grid.Column="1" 
                                    x:Name="track" 
                                    Width="40" 
                                    Height="22" 
                                    CornerRadius="11" 
                                    Background="#272734" 
                                    BorderBrush="#3F3F4E" 
                                    BorderThickness="1.5">
                                <!-- Toggle Thumb -->
                                <Border x:Name="thumb" 
                                        Width="14" 
                                        Height="14" 
                                        CornerRadius="7" 
                                        Background="#9CA3AF" 
                                        HorizontalAlignment="Left" 
                                        Margin="2.5,0,0,0">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" Color="#000000"/>
                                    </Border.Effect>
                                </Border>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#3B82F6"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="thumb" Property="Margin" Value="0,0,2.5,0"/>
                                <Setter TargetName="thumb" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="track" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Popular Website Preset Button Style -->
        <Style x:Key="PopularWebsiteBtnStyle" TargetType="Button">
            <Setter Property="Background" Value="#111116"/>
            <Setter Property="BorderBrush" Value="#1C1C24"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Width" Value="76"/>
            <Setter Property="Height" Value="76"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="16" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252535"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modal Secondary Button Style (Cancel) -->
        <Style x:Key="ModalSecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#13131A"/>
            <Setter Property="BorderBrush" Value="#252530"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#22222E"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F0F14"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modal Primary Button Style (Save to Deck) -->
        <Style x:Key="ModalPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="BorderBrush" Value="#60A5FA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#2563EB"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#93C5FD"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Search Suggestion Item Style -->
        <Style x:Key="SearchSuggestionItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252535"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3B82F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderThickness="1" Background="Transparent" BorderBrush="#1F1F2C">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Border Grid.Row="0" Background="#000000" BorderBrush="#1C1C24" BorderThickness="0,0,0,1">
                <Grid x:Name="TitleBarGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Logo & Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                        <Image Source="LOGO.png" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="SwiftDock" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                        <!-- <TextBlock Text="Control Center" FontSize="10" Foreground="#5A5A7E" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,2,0,0"/> -->
                    </StackPanel>
                    
                    <!-- Middle Drag Area (captured by WindowChrome) -->
                    <Grid Grid.Column="1"/>
                    
                    <!-- Window Control Buttons (Min, Max, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                        <Button x:Name="BtnMinimize" Content="&#xE921;" Style="{StaticResource TitlebarButton}" Click="BtnMinimize_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnMaximizeRestore" Content="&#xE922;" Style="{StaticResource TitlebarButton}" Click="BtnMaximizeRestore_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button x:Name="BtnClose" Content="&#xE8BB;" Style="{StaticResource TitlebarCloseButton}" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <!-- ========== STEP 4: DASHBOARD ========== -->
                <Grid x:Name="PanelStep4" Visibility="Visible" Style="{StaticResource FuturisticPanel}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ===== LEFT SIDEBAR (Single floating section card) ===== -->
                    <Border Grid.Column="0" Background="#0F0F12" BorderBrush="#1F1F2C" BorderThickness="1" CornerRadius="16" Margin="16,16,12,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Row 0: Device status card -->
                                <RowDefinition Height="*"/>    <!-- Row 1: Swappable Views (Profiles vs Settings) -->
                            </Grid.RowDefinitions>

                            <!-- Device status card -->
                            <Border Grid.Row="0" Margin="16,16,16,10" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="12" Padding="14,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- Left: Phone Icon -->
                                    <TextBlock Grid.Column="0" Text="&#xE8EA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="22" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    
                                    <!-- Right: Info -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="LblDeviceName" Text="Your Device" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,2"/>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Status Dot -->
                                            <Ellipse x:Name="DotStatus" Width="6" Height="6" Fill="#EF4444" Margin="0,1,6,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="LblConnectedStatus" Text="Not connected" FontSize="11" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Container Grid for Swappable content in Row 1 -->
                            <Grid Grid.Row="1">
                                <!-- A. PROFILES SIDEBAR PANEL -->
                                <Grid x:Name="GridSidebarProfiles" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Pages Header Label -->
                                        <RowDefinition Height="*"/>    <!-- Pages Scrollable List & Add Button -->
                                        <RowDefinition Height="Auto"/> <!-- Bottom Menu Items (Info, Check update, Help, Bug) -->
                                    </Grid.RowDefinitions>

                                    <!-- Pages label -->
                                    <TextBlock Grid.Row="0" Text="Pages" FontSize="11" Foreground="#8E8E93" FontWeight="SemiBold" Margin="16,12,16,8"/>

                                    <!-- Profile list & Add Profile button -->
                                    <Grid Grid.Row="1" Margin="16,0,16,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/> <!-- Add Button -->
                                        </Grid.RowDefinitions>

                                        <!-- Profiles Scrollable List -->
                                        <ListBox x:Name="ListProfiles" Grid.Row="0" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" SelectionChanged="ListProfiles_SelectionChanged" ItemContainerStyle="{StaticResource ProfileListBoxItemStyle}" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.ScrollUnit="Pixel">
                                            <ListBox.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource HiddenScrollBarStyle}"/>
                                            </ListBox.Resources>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                     <Grid Height="56" HorizontalAlignment="Stretch" Background="Transparent">
                                                          <Grid.ContextMenu>
                                                              <ContextMenu>
                                                                  <MenuItem Header="Move Page Up" Click="MenuItemMoveProfileUp_Click"/>
                                                                  <MenuItem Header="Move Page Down" Click="MenuItemMoveProfileDown_Click"/>
                                                                  <Separator/>
                                                                  <MenuItem Header="Rename Page" Click="MenuItemRenameProfile_Click"/>
                                                                  <MenuItem Header="Lock / Unlock Profile" Click="MenuItemToggleLockProfile_Click"/>
                                                                  <MenuItem Header="Export Profile" Click="MenuItemExportProfile_Click"/>
                                                                  <MenuItem Header="Delete Page" Click="MenuItemDeleteProfile_Click" Foreground="#EF4444"/>
                                                              </ContextMenu>
                                                          </Grid.ContextMenu>
                                                          <Grid.ColumnDefinitions>
                                                              <ColumnDefinition Width="Auto"/>
                                                              <ColumnDefinition Width="*"/>
                                                              <ColumnDefinition Width="Auto"/>
                                                          </Grid.ColumnDefinitions>
                                                          
                                                          <!-- Left mini preview card: Hide keycap configuration for locked profiles -->
                                                          <Border Grid.Column="0" Background="#14141E" BorderBrush="#252535" BorderThickness="1" CornerRadius="8" Padding="4,3" Width="68" Height="42" VerticalAlignment="Center" Margin="2,0,12,0">
                                                              <Grid>
                                                                  <UniformGrid Rows="2" Columns="4" Visibility="{Binding IsLocked, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                      <ContentControl Content="{Binding Buttons, Converter={StaticResource ProfileMiniKeycapConverter}, ConverterParameter=0}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                      <ContentControl Content="{Binding Buttons, Converter={StaticResource ProfileMiniKeycapConverter}, ConverterParameter=1}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                      <ContentControl Content="{Binding Buttons, Converter={StaticResource ProfileMiniKeycapConverter}, ConverterParameter=2}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                      <ContentControl Content="{Binding Buttons, Converter={StaticResource ProfileMiniKeycapConverter}, ConverterParameter=3}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                      <ContentControl Content="{Binding Buttons, Converter={StaticResource ProfileMiniKeycapConverter}, ConverterParameter=4}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                      <ContentControl Content="{Binding Buttons, Converter={StaticResource ProfileMiniKeycapConverter}, ConverterParameter=5}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                      <ContentControl Content="{Binding Buttons, Converter={StaticResource ProfileMiniKeycapConverter}, ConverterParameter=6}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                      <ContentControl Content="{Binding Buttons, Converter={StaticResource ProfileMiniKeycapConverter}, ConverterParameter=7}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                  </UniformGrid>

                                                                  <ContentControl Content="{Binding Converter={StaticResource LockedProfileIconConverter}}" Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                              </Grid>
                                                          </Border>
                                                        
                                                        <!-- Middle: Details -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <!-- Profile Name & Lock Icon -->
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#F59E0B" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsLocked, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Locked Profile"/>
                                                            </StackPanel>
                                                            <!-- Page Subtitle -->
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="Page " FontSize="11" Foreground="#71717A"/>
                                                                <TextBlock Text="{Binding PageNumber}" FontSize="11" Foreground="#71717A"/>
                                                                <TextBlock Text=" • " FontSize="11" Foreground="#71717A"/>
                                                                <TextBlock Text="{Binding ConfiguredButtonsCount}" FontSize="11" Foreground="#71717A"/>
                                                                <TextBlock Text="/63" FontSize="11" Foreground="#71717A"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                         <!-- Right: Move Up / Down Buttons -->
                                                         <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="4,0,2,0">
                                                             <Button Click="BtnMoveProfileUp_Click" Tag="{Binding}" Style="{StaticResource GhostButton}" Height="18" Width="22" Padding="0" Cursor="Hand" ToolTip="Move Page Up">
                                                                 <TextBlock Text="&#xE70E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                             </Button>
                                                             <Button Click="BtnMoveProfileDown_Click" Tag="{Binding}" Style="{StaticResource GhostButton}" Height="18" Width="22" Padding="0" Cursor="Hand" ToolTip="Move Page Down" Margin="0,2,0,0">
                                                                 <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#A1A1AA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                             </Button>
                                                         </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <!-- Add Profile & Import Profile buttons -->
                                        <Grid Grid.Row="1" Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource SidebarMenuItemStyle}" Click="BtnAddProfile_Click" Height="44" Padding="0">
                                                <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Background="Transparent" Padding="6,4">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE109;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="New Page" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                            <Button Grid.Column="2" x:Name="BtnImportProfile" Style="{StaticResource SidebarMenuItemStyle}" Click="BtnImportProfile_Click" Height="44" Padding="0">
                                                <Border BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8" Background="Transparent" Padding="6,4">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#71717A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                                        <TextBlock Text="Import" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <!-- Bottom Row Buttons -->
                                    <StackPanel Grid.Row="2" Margin="16,0,16,16">
                                        <!-- Horizontal divider -->
                                        <Border BorderBrush="#1C1C24" BorderThickness="0,1,0,0" Margin="0,4,0,8"/>
                                        
                                        <!-- Settings -->
                                        <Button x:Name="BtnOpenSettings" Style="{StaticResource SidebarMenuItemStyle}" Click="BtnOpenSettings_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Settings" FontSize="13" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Volume Buttons -->
                                        <Button x:Name="BtnVolumeButtons" Style="{StaticResource SidebarMenuItemStyle}" Click="BtnVolumeButtons_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE995;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Volume Buttons" FontSize="13" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- About SwiftDock -->
                                        <Button x:Name="BtnAbout" Style="{StaticResource SidebarMenuItemStyle}" Click="BtnAbout_Click">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="About SwiftDock" FontSize="13" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="v1.3" FontSize="11" Foreground="#71717A" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Button>

                                        <!-- Check for Updates -->
                                        <Button x:Name="BtnCheckUpdates" Style="{StaticResource SidebarMenuItemStyle}" Click="BtnCheckUpdates_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Check for Updates" FontSize="13" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Help & Feedback -->
                                        <Button x:Name="BtnHelpFeedback" Style="{StaticResource SidebarMenuItemStyle}" Click="BtnHelpFeedback_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE11B;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Help &amp; Feedback" FontSize="13" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>

                                        <!-- Report a Bug -->
                                        <Button x:Name="BtnReportBug" Style="{StaticResource SidebarMenuItemStyle}" Click="BtnReportBug_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xEBE8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#A1A1AA" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Text="Report a Bug" FontSize="13" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <!-- B. SETTINGS SIDEBAR PANEL -->
                                <Grid x:Name="GridSidebarSettings" Visibility="Collapsed" Margin="16,12,16,14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Settings Header label -->
                                        <RowDefinition Height="*"/>    <!-- Scrollable settings form content -->
                                        <RowDefinition Height="Auto"/> <!-- Back to Profiles button -->
                                    </Grid.RowDefinitions>

                                    <!-- Settings Header label -->
                                    <TextBlock Grid.Row="0" Text="Settings" FontSize="14" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,14"/>

                                    <!-- Scrollable settings form content -->
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Margin="0,0,0,12">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource HiddenScrollBarStyle}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel Orientation="Vertical">

                                            <!-- Card 1: Device Info & Startup -->
                                            <Border Background="#14141E" BorderBrush="#252538" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                        <TextBlock Text="&#xE8EA;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Device Name" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Grid Margin="0,0,0,12">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox x:Name="TxtSettingsDeviceName" Height="36" Padding="10,0" VerticalContentAlignment="Center" FontSize="12" Foreground="#FFFFFF" Background="#1C1C28" BorderBrush="#2F2F42" BorderThickness="1" Margin="0,0,8,0"/>
                                                        <Button x:Name="BtnSaveSettingsDeviceName" Grid.Column="1" Content="Save" Style="{StaticResource PrimaryButton}" Click="BtnSaveSettingsDeviceName_Click" Height="36" Padding="14,0" FontSize="12" FontWeight="SemiBold"/>
                                                    </Grid>

                                                    <Border BorderBrush="#232332" BorderThickness="0,1,0,0" Margin="0,2,0,10"/>

                                                    <CheckBox x:Name="ChkAutoStart" Content="Run on Windows Startup" Style="{StaticResource ToggleSwitchStyle}" Click="ChkAutoStart_Click" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 2: Keycap Accent Glow Settings -->
                                            <Border Background="#14141E" BorderBrush="#252538" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,14">
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Keycap Accent Glow" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock Text="Remove accent glow borders from all keycaps across all profiles." FontSize="10.5" Foreground="#71717A" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                                    <Button x:Name="BtnRemoveAllAccents" Content="Remove All Keycap Accents" Style="{StaticResource SecondaryButton}" Height="34" Padding="6,0" Click="BtnRemoveAllAccents_Click" HorizontalAlignment="Stretch" Cursor="Hand" FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock x:Name="LblSettingsAccentStatus" Text="" FontSize="10.5" Foreground="#10B981" HorizontalAlignment="Center" Visibility="Collapsed"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 3: Profile Security & PIN Settings -->
                                            <Border Background="#14141E" BorderBrush="#252538" BorderThickness="1" CornerRadius="12" Padding="14,12" Margin="0,0,0,12">
                                                <StackPanel Orientation="Vertical">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                        <TextBlock Text="Profile PIN Security" FontSize="11" FontWeight="SemiBold" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <TextBlock x:Name="LblCurrentPinStatus" Text="Status: No PIN set" FontSize="10.5" Foreground="#10B981" Margin="0,0,0,10"/>

                                                    <!-- Old PIN -->
                                                    <TextBlock x:Name="LblOldPin" Text="Current PIN" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,4"/>
                                                    <PasswordBox x:Name="TxtOldPin" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="#1C1C28" BorderBrush="#2F2F42" BorderThickness="1" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                                                    <!-- New PIN -->
                                                    <TextBlock Text="New PIN (4-6 digits)" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,4"/>
                                                    <PasswordBox x:Name="TxtNewPin" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="#1C1C28" BorderBrush="#2F2F42" BorderThickness="1" Foreground="#FFFFFF" Margin="0,0,0,8"/>

                                                    <!-- Confirm PIN -->
                                                    <TextBlock Text="Confirm New PIN" FontSize="10.5" Foreground="#71717A" Margin="0,0,0,4"/>
                                                    <PasswordBox x:Name="TxtConfirmPin" Height="34" Padding="10,0" VerticalContentAlignment="Center" Background="#1C1C28" BorderBrush="#2F2F42" BorderThickness="1" Foreground="#FFFFFF" Margin="0,0,0,10"/>

                                                    <Button x:Name="BtnSaveProfilePin" Content="Save Profile PIN" Style="{StaticResource PrimaryButton}" Height="34" Click="BtnSaveProfilePin_Click" HorizontalAlignment="Stretch" FontSize="12" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>

                                    <!-- Back Button -->
                                    <Button Grid.Row="2" Style="{StaticResource SecondaryButton}" Click="BtnBackToDashboard_Click" Height="40" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Stretch" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#E4E4E7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Back to Profiles" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- ===== MAIN CONTENT AREA (Single canvas background, no outer border card) ===== -->
                    <Grid Grid.Column="1" Margin="16,16,16,16">
                        <Grid>
                            <!-- Dashboard Views container -->
                            
                            <!-- 1. Normal View (Grid and Properties) -->
                            <Grid x:Name="GridDashboardMainContent" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- 1. Preview and Nav Row -->
                                    <RowDefinition Height="Auto"/> <!-- 2. Page Dots Indicator -->
                                    <RowDefinition Height="Auto"/> <!-- 3. Divider -->
                                    <RowDefinition Height="Auto"/> <!-- 4. Categories selector -->
                                    <RowDefinition Height="Auto"/> <!-- 5. Divider -->
                                    <RowDefinition Height="*"/>    <!-- 6. Property editor / Placeholder -->
                                </Grid.RowDefinitions>
                                 <!-- Preview Row containing navigation and grid -->
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Left arrow -->
                                        <ColumnDefinition Width="*"/>    <!-- Phone Container -->
                                        <ColumnDefinition Width="Auto"/> <!-- Right arrow -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Navigation Arrow -->
                                    <Button x:Name="BtnPrevPage" Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="32" Style="{StaticResource GhostButton}" Click="BtnPrevPage_Click" VerticalAlignment="Center" Margin="0,0,16,0"/>
                                    
                                    <!-- Black Phone Chassis Container with Top-Left Bumps -->
                                     <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                         <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto"/> <!-- Bumps Row -->
                                             <RowDefinition Height="Auto"/> <!-- Main Body Row -->
                                             <RowDefinition Height="Auto"/> <!-- Page Dots Row (Outside Mobile Frame) -->
                                         </Grid.RowDefinitions>

                                         <!-- Bumps (Power and Volume) aligned on the top-left edge -->
                                         <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="48,0,0,-1">
                                             <!-- Power Button Bump -->
                                             <Border Width="32" Height="6" Background="#24242B" CornerRadius="3,3,0,0" BorderBrush="#1C1C24" BorderThickness="1,1,1,0"/>
                                             <!-- Spacer -->
                                             <Canvas Width="16" Height="6"/>
                                             <!-- Volume Rocker Bump -->
                                             <Border Width="64" Height="6" Background="#24242B" CornerRadius="3,3,0,0" BorderBrush="#1C1C24" BorderThickness="1,1,1,0"/>
                                         </StackPanel>

                                         <!-- Main Phone Body Border -->
                                         <Border Grid.Row="1" 
                                                 Background="#0C0C0F" 
                                                 BorderBrush="#24242B" 
                                                 BorderThickness="4" 
                                                 CornerRadius="28" 
                                                 Padding="20, 18, 20, 18" 
                                                 HorizontalAlignment="Center" 
                                                 VerticalAlignment="Center">
                                             <Border.Effect>
                                                 <DropShadowEffect BlurRadius="15" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                             </Border.Effect>
                                             
                                             <!-- UniformGrid of Buttons inside Phone Frame -->
                                             <UniformGrid x:Name="GridPreview" Columns="4" Rows="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                         </Border>

                                         <!-- Page Dots Indicator outside the phone frame, centered below -->
                                         <StackPanel x:Name="PanelPageDots" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"/>
                                     </Grid>

                                    <!-- Right Navigation Arrow -->
                                    <Button x:Name="BtnNextPage" Grid.Column="2" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="32" Style="{StaticResource GhostButton}" Click="BtnNextPage_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                </Grid>
                                  <!-- Floating Action Buttons (Done Rearranging & Bulk Actions) in the top-right corner of Row 0 -->
                                  <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,16,0">
                                      <!-- Done Rearranging Button -->
                                      <Button x:Name="BtnDoneRearrangingHeader" 
                                              Click="BtnRearrangeDock_Click" 
                                              Visibility="Collapsed" 
                                              Style="{StaticResource SuccessPillButton}" 
                                              Margin="0,0,8,0" 
                                              ToolTip="Finish Rearranging Deck">
                                          <StackPanel Orientation="Horizontal">
                                              <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                              <TextBlock Text="Done Rearranging" VerticalAlignment="Center"/>
                                          </StackPanel>
                                      </Button>

                                      <!-- Bulk Actions Panel -->
                                      <StackPanel x:Name="PanelBulkActions" Orientation="Horizontal" Visibility="Collapsed">
                                          <Button x:Name="BtnDeleteSelectedBulk" Content="Delete Selected (0)" Style="{StaticResource DangerPillButton}" Click="BtnDeleteSelectedBulk_Click"/>
                                      </StackPanel>
                                  </StackPanel>

                                  <!-- Action Category Selectors Capsule & Search Bar Row -->
                                  <Grid Grid.Row="3" Margin="0,4,0,8">
                                      <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="Auto"/> <!-- Left: Category Tabs Capsule & Rearrange -->
                                          <ColumnDefinition Width="*"/>    <!-- Middle Spacer -->
                                          <ColumnDefinition Width="Auto"/> <!-- Right: Search Bar -->
                                      </Grid.ColumnDefinitions>

                                      <!-- Left: Category Tabs Capsule & Rearrange Button -->
                                      <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                          <Border Background="#13131A" BorderBrush="#252530" BorderThickness="1" CornerRadius="8" Padding="3" VerticalAlignment="Center">
                                              <StackPanel Orientation="Horizontal">
                                                  <!-- App -->
                                                  <Button x:Name="TabBtnApp" Click="TabBtn_Click" Tag="App" Style="{StaticResource CategoryTabButton}" Content="Apps"/>
                                                  
                                                  <!-- Setting (Controls) -->
                                                  <Button x:Name="TabBtnSetting" Click="TabBtn_Click" Tag="System" Style="{StaticResource CategoryTabButton}" Content="Controls" Margin="2,0,0,0"/>
                                                  
                                                  <!-- Ctrl (URL) -->
                                                  <Button x:Name="TabBtnCtrl" Click="TabBtn_Click" Tag="URL" Style="{StaticResource CategoryTabButton}" Content="URL" Margin="2,0,0,0"/>
                                                  
                                                  <!-- Profiles -->
                                                  <Button x:Name="TabBtnProfile" Click="TabBtn_Click" Tag="Profile" Style="{StaticResource CategoryTabButton}" Content="Profiles" Margin="2,0,0,0"/>

                                                  <!-- Hot Keys -->
                                                  <Button x:Name="TabBtnHotkey" Click="TabBtn_Click" Tag="Hotkey" Style="{StaticResource CategoryTabButton}" Content="Hot Keys" Margin="2,0,0,0"/>
                                              </StackPanel>
                                          </Border>

                                          <Button x:Name="BtnRearrangeDock" Click="BtnRearrangeDock_Click" Style="{StaticResource SecondaryButton}" Height="34" Padding="12,0" Margin="10,0,0,0" Cursor="Hand" Visibility="Collapsed">
                                              <StackPanel Orientation="Horizontal">
                                                  <TextBlock x:Name="IconRearrangeDock" Text="&#xE8D8;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                  <TextBlock x:Name="LblRearrangeDock" Text="Rearrange" FontSize="12" FontWeight="SemiBold" Foreground="#E4E4E7" VerticalAlignment="Center"/>
                                              </StackPanel>
                                          </Button>
                                      </StackPanel>

                                      <!-- Right: Search Bar Container (In line with main category bar) -->
                                      <Grid Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                          <!-- App Search Bar -->
                                          <Grid x:Name="PanelAppSearch" Visibility="Collapsed" Width="260">
                                              <Border Background="#13131A" BorderBrush="#252530" BorderThickness="1" CornerRadius="8" Height="36">
                                                  <Grid>
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto"/>
                                                          <ColumnDefinition Width="*"/>
                                                      </Grid.ColumnDefinitions>
                                                      <!-- Search Icon -->
                                                      <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                                      <!-- Search Input -->
                                                      <Grid Grid.Column="1">
                                                          <TextBox x:Name="TxtAppSearch" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" Padding="0" VerticalContentAlignment="Center" FontSize="12" TextChanged="TxtAppSearch_TextChanged"/>
                                                          <TextBlock x:Name="TxtAppSearchWatermark" Text="Search installed apps..." Foreground="#6B7280" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                                      </Grid>
                                                  </Grid>
                                              </Border>
                                          </Grid>

                                          <!-- URL Search Bar -->
                                          <Grid x:Name="PanelUrlSearch" Visibility="Collapsed" Width="340">
                                              <Border Background="#13131A" BorderBrush="#252530" BorderThickness="1" CornerRadius="8" Height="36">
                                                  <Grid>
                                                      <Grid.ColumnDefinitions>
                                                          <ColumnDefinition Width="Auto"/>
                                                          <ColumnDefinition Width="*"/>
                                                      </Grid.ColumnDefinitions>
                                                      <!-- Search Icon -->
                                                      <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,6,0"/>
                                                      <!-- Search Input -->
                                                      <Grid Grid.Column="1">
                                                          <TextBox x:Name="TxtUrlSearch" Background="Transparent" BorderThickness="0" Foreground="#FFFFFF" Padding="0" VerticalContentAlignment="Center" FontSize="12"/>
                                                          <TextBlock x:Name="TxtUrlSearchWatermark" Text="Search website or paste link..." Foreground="#6B7280" FontSize="12" IsHitTestVisible="False" VerticalAlignment="Center"/>
                                                      </Grid>
                                                  </Grid>
                                              </Border>
                                          </Grid>
                                      </Grid>
                                 </Grid>

                                 <!-- Property Editor panel -->
                                  <Grid Grid.Row="5" x:Name="PanelButtonProperties" Visibility="Collapsed">
                                      <Grid.RowDefinitions>
                                          <RowDefinition Height="*" />
                                          <RowDefinition Height="Auto" />
                                      </Grid.RowDefinitions>

                                      <!-- Middle Area: Scrollable parameter editors -->
                                      <Grid Grid.Row="0">
                                            <Grid x:Name="PanelActionParameter" Visibility="Visible">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <!-- Sub-Tab Header Bar for General Actions (Apps, Controls, URL, Hot Keys) -->
                                                <Border x:Name="BorderActionSubTabs" Grid.Row="0" Background="#13131A" BorderBrush="#252530" BorderThickness="1" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,16">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button x:Name="BtnActionTabSelect" Content="Select Action" Click="BtnActionTab_Click" Tag="ActionSelect" Style="{StaticResource CategoryTabButton}" Padding="12,6"/>
                                                        <Button x:Name="BtnActionTabKeycap" Content="Configure Keycap" Click="BtnActionTab_Click" Tag="ActionKeycap" Style="{StaticResource CategoryTabButton}" Margin="4,0,0,0" Padding="12,6"/>
                                                    </StackPanel>
                                                </Border>

                                               <!-- Sub-panel 1: General Action Selection List Container -->
                                               <Grid x:Name="PanelGeneralActionSelectContainer" Grid.Row="1" Visibility="Visible">
                                                   <Grid.RowDefinitions>
                                                       <RowDefinition Height="Auto"/>
                                                       <RowDefinition Height="Auto"/>
                                                       <RowDefinition Height="*"/>
                                                   </Grid.RowDefinitions>
                                                   
                                                   <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,12">
                                                       <TextBlock x:Name="LblActionParameter" Text="Action Detail" FontSize="11" Foreground="#9CA3AF" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                                   </StackPanel>
                                             
                                                   <ListBox x:Name="ListInstalledApps" Grid.Row="2" Visibility="Collapsed" 
                                                            Background="Transparent" BorderThickness="0"
                                                            HorizontalContentAlignment="Stretch"
                                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                            ScrollViewer.CanContentScroll="False"
                                                            SelectionChanged="ListInstalledApps_SelectionChanged" Margin="0,0,0,12"
                                                            PreviewMouseWheel="ListInstalledApps_PreviewMouseWheel">
                                                       <ListBox.Resources>
                                                           <Style TargetType="ListBoxItem">
                                                               <Setter Property="Background" Value="Transparent"/>
                                                               <Setter Property="BorderThickness" Value="0"/>
                                                               <Setter Property="Margin" Value="4,0,4,12"/>
                                                               <Setter Property="Padding" Value="0"/>
                                                               <Setter Property="Template">
                                                                   <Setter.Value>
                                                                       <ControlTemplate TargetType="ListBoxItem">
                                                                           <StackPanel Orientation="Vertical" Width="76" HorizontalAlignment="Center" ToolTip="{Binding DisplayName}">
                                                                               <!-- Square Keycap Button Box (76x76) -->
                                                                               <Border x:Name="border" Width="76" Height="76" CornerRadius="16" Background="#111116" BorderBrush="#1C1C24" BorderThickness="1.5" SnapsToDevicePixels="true">
                                                                                   <Image Source="{Binding Icon}" Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                               </Border>
                                                                               <!-- Text Label Outside & Underneath -->
                                                                               <TextBlock Text="{Binding DisplayName}" FontSize="10.5" FontWeight="Medium" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="76"/>
                                                                           </StackPanel>
                                                                           <ControlTemplate.Triggers>
                                                                               <Trigger Property="IsMouseOver" Value="true">
                                                                                   <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                                                                   <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                                                               </Trigger>
                                                                               <Trigger Property="IsSelected" Value="true">
                                                                                   <Setter TargetName="border" Property="Background" Value="#252535"/>
                                                                                   <Setter TargetName="border" Property="BorderBrush" Value="#FFFFFF"/>
                                                                                   <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                                               </Trigger>
                                                                           </ControlTemplate.Triggers>
                                                                       </ControlTemplate>
                                                                   </Setter.Value>
                                                               </Setter>
                                                           </Style>
                                                       </ListBox.Resources>
                                                       <ListBox.ItemsPanel>
                                                           <ItemsPanelTemplate>
                                                               <WrapPanel IsItemsHost="True" Orientation="Horizontal" HorizontalAlignment="Left" />
                                                           </ItemsPanelTemplate>
                                                       </ListBox.ItemsPanel>
                                                   </ListBox>
                                             
                                                   <ScrollViewer x:Name="ScrollUrlLinks" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
                                                        <StackPanel Margin="0,0,8,0" Orientation="Vertical">
