                                                                           <ControlTemplate TargetType="Button">
                                                                               <Border CornerRadius="11" Background="#A855F7"/>
                                                                           </ControlTemplate>
                                                                       </Button.Template>
                                                                   </Button>
                                                                   <Button Click="BtnKeycapColorSwatch_Click" Tag="#FF3B30" ToolTip="Crimson Red" Width="22" Height="22" Margin="0,0,6,0" Cursor="Hand">
