                                                        <StackPanel x:Name="PanelSystemActionsContainer" Orientation="Vertical" Margin="0,0,8,0"/>
                                                    </ScrollViewer>
                                                    <ScrollViewer x:Name="ScrollHotkeyActions" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,12">
                                                         <StackPanel Orientation="Vertical" Margin="0,0,8,0">
                                                              <!-- Custom Hotkey Recording Card -->
                                                              <Border Background="#121218" BorderBrush="#22222E" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,20">
                                                                  <StackPanel Orientation="Vertical">
                                                                      <!-- Card Header -->
                                                                      <Grid Margin="0,0,0,14">
                                                                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                              <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#9CA3AF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                              <TextBlock Text="CUSTOM KEY COMBINATION" FontSize="11.5" FontWeight="Bold" Foreground="#E5E7EB"/>
                                                                          </StackPanel>
                                                                          <TextBlock Text="Click input below &amp; press shortcut keys" FontSize="11" Foreground="#6B7280" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                                      </Grid>

                                                                      <!-- 3-Column Input Grid (Icon Selector, Combination Name & Shortcut Keys) -->
                                                                      <Grid Margin="0,0,0,14">
                                                                          <Grid.ColumnDefinitions>
                                                                              <ColumnDefinition Width="Auto"/>
                                                                              <ColumnDefinition Width="12"/>
                                                                              <ColumnDefinition Width="*"/>
                                                                              <ColumnDefinition Width="12"/>
                                                                              <ColumnDefinition Width="*"/>
                                                                          </Grid.ColumnDefinitions>

                                                                          <!-- Column 0: Icon Selector Button -->
                                                                          <StackPanel Grid.Column="0" Orientation="Vertical">
                                                                              <TextBlock Text="Select Icon" FontSize="11" FontWeight="Medium" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                                                              <Border x:Name="BorderHotkeyIconPicker" Background="#181822" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Height="38" Width="48">
                                                                                  <Button x:Name="BtnHotkeyIconPicker" Click="BtnBrowseReicons_Click" Style="{StaticResource SecondaryButton}" Background="Transparent" BorderThickness="0" Padding="0" ToolTip="Click to select icon from library">
                                                                                      <ContentControl x:Name="ContentHotkeyIconPreview"/>
                                                                                  </Button>
                                                                              </Border>
                                                                          </StackPanel>

                                                                          <!-- Column 2: Combination Name -->
                                                                          <StackPanel Grid.Column="2" Orientation="Vertical">
                                                                              <TextBlock Text="Combination Name (Required)" FontSize="11" FontWeight="Medium" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                                                              <Border x:Name="BorderHotkeyName" Background="#181822" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Height="38" Padding="10,0">
                                                                                  <Grid VerticalAlignment="Center">
                                                                                      <TextBlock Text="Enter combination name..." Foreground="#6B7280" FontSize="12.5" IsHitTestVisible="False" VerticalAlignment="Center">
                                                                                          <TextBlock.Style>
                                                                                              <Style TargetType="TextBlock">
                                                                                                  <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                  <Style.Triggers>
                                                                                                      <DataTrigger Binding="{Binding Text, ElementName=TxtHotkeyName}" Value="">
                                                                                                          <Setter Property="Visibility" Value="Visible"/>
                                                                                                      </DataTrigger>
                                                                                                  </Style.Triggers>
                                                                                              </Style>
                                                                                          </TextBlock.Style>
                                                                                      </TextBlock>
                                                                                      <TextBox x:Name="TxtHotkeyName" Style="{StaticResource CleanBorderlessTextBox}" TextChanged="TxtHotkeyName_TextChanged" KeyDown="TxtHotkeyName_KeyDown"/>
                                                                                  </Grid>
                                                                              </Border>
                                                                              <TextBlock x:Name="TxtHotkeyNameError" Text="Please enter a combination name" FontSize="10.5" Foreground="#EF4444" Margin="0,4,0,0" Visibility="Collapsed"/>
                                                                          </StackPanel>

                                                                          <!-- Column 4: Shortcut Keys Recorder -->
                                                                          <StackPanel Grid.Column="4" Orientation="Vertical">
                                                                              <TextBlock Text="Recorded Keys" FontSize="11" FontWeight="Medium" Foreground="#9CA3AF" Margin="0,0,0,6"/>
                                                                              <Border Background="#181822" BorderBrush="#2A2A3A" BorderThickness="1" CornerRadius="8" Height="38" Padding="10,0">
                                                                                  <Grid VerticalAlignment="Center">
                                                                                      <TextBlock Text="Click &amp; press shortcut keys..." Foreground="#6B7280" FontSize="12.5" IsHitTestVisible="False" VerticalAlignment="Center">
                                                                                          <TextBlock.Style>
                                                                                              <Style TargetType="TextBlock">
                                                                                                  <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                  <Style.Triggers>
                                                                                                      <DataTrigger Binding="{Binding Text, ElementName=TxtHotkeyRecorder}" Value="">
                                                                                                          <Setter Property="Visibility" Value="Visible"/>
                                                                                                      </DataTrigger>
                                                                                                  </Style.Triggers>
                                                                                              </Style>
                                                                                          </TextBlock.Style>
                                                                                      </TextBlock>
                                                                                      <TextBox x:Name="TxtHotkeyRecorder" Style="{StaticResource CleanBorderlessTextBox}" FontWeight="SemiBold" Text="" IsReadOnly="True" PreviewKeyDown="TxtHotkeyRecorder_PreviewKeyDown" GotFocus="TxtHotkeyRecorder_GotFocus" LostFocus="TxtHotkeyRecorder_LostFocus" PreviewMouseLeftButtonDown="TxtHotkeyRecorder_PreviewMouseLeftButtonDown"/>
                                                                                  </Grid>
                                                                              </Border>
                                                                          </StackPanel>
                                                                      </Grid>                                                                 <!-- Save & Clear Action Buttons Row -->
                                                                       <Grid Margin="0,0,0,4">
