                                                                           </ControlTemplate>
                                                                       </Button.Template>
                                                                   </Button>
                                                                   <Button Click="BtnKeycapColorSwatch_Click" Tag="#A855F7" ToolTip="Electric Violet" Width="22" Height="22" Margin="0,0,6,0" Cursor="Hand">
