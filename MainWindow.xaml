                                                          <Setter Property="Template">
                                                              <Setter.Value>
                                                                  <ControlTemplate TargetType="ListBoxItem">
                                                                      <StackPanel Orientation="Vertical" Width="76" HorizontalAlignment="Center" ToolTip="{Binding Name}">
                                                                          <!-- Square Keycap Button Box (76x76) -->
                                                                          <Border x:Name="border" Width="76" Height="76" CornerRadius="16" Background="#111116" BorderBrush="#1C1C24" BorderThickness="1.5" SnapsToDevicePixels="true">
                                                                              <Path Data="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z" Fill="#FFFFFF" Height="34" Width="34" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                          </Border>
                                                                          <!-- Text Label Outside & Underneath -->
                                                                          <TextBlock x:Name="lblTxt" Text="{Binding Name}" FontSize="10.5" FontWeight="Medium" Foreground="#9CA3AF" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="76"/>
                                                                      </StackPanel>
                                                                      <ControlTemplate.Triggers>
                                                                          <Trigger Property="IsMouseOver" Value="true">
                                                                              <Setter TargetName="border" Property="Background" Value="#1E1E28"/>
                                                                              <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                                                              <Setter TargetName="lblTxt" Property="Foreground" Value="#FFFFFF"/>
                                                                          </Trigger>
                                                                          <Trigger Property="IsSelected" Value="true">
                                                                              <Setter TargetName="border" Property="Background" Value="#252535"/>
                                                                              <Setter TargetName="border" Property="BorderBrush" Value="#3B82F6"/>
                                                                              <Setter TargetName="border" Property="BorderThickness" Value="2"/>
                                                                              <Setter TargetName="lblTxt" Property="Foreground" Value="#FFFFFF"/>
                                                                              <Setter TargetName="lblTxt" Property="FontWeight" Value="SemiBold"/>
                                                                          </Trigger>
                                                                      </ControlTemplate.Triggers>
                                                                  </ControlTemplate>
                                                              </Setter.Value>
                                                          </Setter>
                                                      </Style>
                                                  </ListBox.Resources>
