<Window x:Class="SwiftDock.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SwiftDock"
        Height="400" Width="400"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        ShowInTaskbar="False">

    <Grid>
        <Border Background="#000000" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
            </Border.Effect>

            <Grid>
                <!-- Logo Container -->
                <Grid Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-40,0,0">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="LogoScale" ScaleX="1.0" ScaleY="1.0"/>
                    </Grid.RenderTransform>

                    <Grid.Effect>
                        <DropShadowEffect x:Name="LogoGlow" Color="#FFFFFF" BlurRadius="40" ShadowDepth="0" Opacity="0.3"/>
                    </Grid.Effect>

                    <!-- SwiftDock Logo Image -->
                    <Image Source="LOGO.png"
                           Width="200"
                           Height="200"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>

                <!-- Loading Status Text -->
                <TextBlock x:Name="StatusText"
                           Text="INITIALIZING..."
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="#888888"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,80"/>

                <!-- App Name -->
                <TextBlock Text="SWIFTDOCK"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Bottom"
                           Margin="0,0,0,45"
                           Opacity="0.9"/>
            </Grid>
        </Border>
    </Grid>
</Window>
